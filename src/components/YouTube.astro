---
// A YouTube thumbnail that swaps in the real player when clicked, so pages with many
// videos don't load dozens of players up front. Without JavaScript it links to YouTube.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---
<div class="frame">
  <a class="yt" href={`https://www.youtube.com/watch?v=${id}`} data-yt={id} data-title={title} aria-label={`Play video: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy">
  </a>
</div>

<script>
  // Replace a clicked thumbnail with the YouTube player.
  document.addEventListener('click', (e) => {
    const link = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('a[data-yt]') : null;
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube.com/embed/${link.dataset.yt}?autoplay=1`;
    iframe.title = link.dataset.title ?? 'YouTube video';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    link.replaceWith(iframe);
    iframe.focus();
  });
</script>
