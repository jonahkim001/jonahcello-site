---
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import data from '../data/videos.json';

// Featured videos, in the order listed under "featured". Their title and description default to
// the performance they belong to, unless the video sets featuredTitle / featuredMeta.
const featured = data.featured.map((id) => {
  const performance = data.performances.find((p) => p.videos?.some((v) => v.id === id));
  if (!performance) throw new Error(`Featured video ${id} is not listed under any performance in videos.json`);
  const video = performance.videos.find((v) => v.id === id);
  return { id, title: video.featuredTitle ?? performance.title, meta: video.featuredMeta ?? performance.meta, videoTitle: video.title };
});

// Everything else, skipping videos already featured above.
// A performance drops out only if all of its videos are featured and it has no audio.
const more = data.performances
  .map((p) => ({ ...p, allFeatured: !!p.videos?.length, videos: (p.videos ?? []).filter((v) => !data.featured.includes(v.id)) }))
  .filter((p) => p.videos.length > 0 || p.audio || !p.allFeatured);
---
<Base title="Stream — Jonah Kim" description="Watch and listen to cellist Jonah Kim in live performances of Bach, Brahms, Beethoven, Tchaikovsky, and more." path="/listen.html" active="stream">
  <h1 class="page-title">Stream</h1>

  <h2 class="section-title">Featured</h2>
  <div class="video-grid">
    {featured.map((f) => (
      <div class="video-item">
        <YouTube id={f.id} title={f.videoTitle} />
        <h3>{f.title}</h3>
        <p class="meta">{f.meta}</p>
      </div>
    ))}
  </div>

  <h2 class="section-title spaced">More Performances</h2>
  <div class="video-grid">
    {more.map((p) => (
      <div class="video-item">
        <h3>{p.title}</h3>
        <p class="meta">{p.meta}</p>
        {p.videos.length > 1 ? (
          <div class="stack">
            {p.videos.map((v) => (
              <div>
                <YouTube id={v.id} title={v.title} />
                <p class="video-caption">{v.title}</p>
              </div>
            ))}
          </div>
        ) : (
          p.videos.map((v) => <YouTube id={v.id} title={v.title} />)
        )}
        {p.audio && <audio controls src={p.audio}></audio>}
      </div>
    ))}
  </div>
</Base>
