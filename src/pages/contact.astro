---
import Base from '../layouts/Base.astro';
import SocialIcons from '../components/SocialIcons.astro';
---
<Base title="Contact — Jonah Kim" description="Contact cellist Jonah Kim for booking and inquiries." path="/contact.html" active="contact">
  <h1 class="page-title">Contact</h1>

  <div class="notice">
    This form currently opens your own email client with the message pre-filled (no server behind it, since the site is now static). If you&rsquo;d rather have replies land straight in an inbox, swap the form&rsquo;s <code>action</code> for a free service like Formspree, or replace it with a simple mailto link.
  </div>

  <form class="form-grid" action="mailto:booking@jonahcello.com" method="post" enctype="text/plain">
    <div class="name-row">
      <div>
        <label for="fname">First Name (required)</label>
        <input id="fname" name="First Name" type="text" required>
      </div>
      <div>
        <label for="lname">Last Name (required)</label>
        <input id="lname" name="Last Name" type="text" required>
      </div>
    </div>
    <div>
      <label for="email">Email Address (required)</label>
      <input id="email" name="Email" type="email" required>
    </div>
    <div>
      <label for="subject">Subject (required)</label>
      <input id="subject" name="Subject" type="text" required>
    </div>
    <div>
      <label for="message">Message (required)</label>
      <textarea id="message" name="Message" required></textarea>
    </div>
    <div>
      <button type="submit" class="btn solid">Submit</button>
    </div>
  </form>

  <h2 class="section-title spaced">Social Media</h2>
  <SocialIcons />
</Base>
