---
// Shared page shell: <head> tags, header, nav, and footer used by every page.
import eventData from '../data/events.json';
import SocialIcons from '../components/SocialIcons.astro';
interface Props {
  title: string;
  description: string;
  /** Page path on the live site, e.g. "/about.html" (used for canonical and share URLs). Omit for pages that shouldn't be indexed. */
  path?: string;
  /** Which nav link to highlight. */
  active?: string;
}

const { title, description, path, active } = Astro.props;
const site = 'https://www.jonahcello.com';
const url = path ? `${site}${path}` : undefined;
const shareImage = `${site}/images/jonah-kim-hero.jpg`;

const nav = [
  { key: 'home', href: '/', label: 'Home' },
  { key: 'about', href: '/about.html', label: 'About' },
  { key: 'records', href: '/discography.html', label: 'Records' },
  { key: 'stream', href: '/listen.html', label: 'Stream' },
  { key: 'photos', href: '/gallery.html', label: 'Photos' },
  { key: 'store', href: '/store.html', label: 'Store' },
  { key: 'calendar', href: '/calendar.html', label: 'Calendar' },
  { key: 'contact', href: '/contact.html', label: 'Contact' },
];

// Announcement bar: the next performance from events.json. The build picks one, and a small
// script re-picks it in the browser so the bar stays current between deploys.
const upcoming = eventData.events.map((e) => ({
  end: e.end,
  date: e.day === 'TBA' ? e.month : `${e.month} ${e.day}`,
  title: e.title.replace(/<[^>]+>/g, ''),
  tickets: e.tickets ?? null,
}));
const isUpcoming = (e, now) => {
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  return new Date(`${e.end}T23:59:59`) >= today;
};
const next = upcoming.find((e) => isUpcoming(e, new Date()));

---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{url && <link rel="canonical" href={url}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Jonah Kim, cello">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{url && <meta property="og:url" content={url}>}
{!url && <meta name="robots" content="noindex">}
<meta property="og:image" content={shareImage}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Jost:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
<slot name="head" />
</head>
<body>
<div class="announce" id="announce">{next ? (
  <>Next performance &middot; {next.date} &middot; {next.title} &middot; {next.tickets
    ? <a href={next.tickets} target="_blank" rel="noopener">Tickets</a>
    : <a href="/calendar.html">Details</a>}</>
) : <>&nbsp;</>}</div>
<script is:inline define:vars={{ upcoming }}>
  (function () {
    var bar = document.getElementById('announce');
    var today = new Date();
    today.setHours(0, 0, 0, 0);
    var next = upcoming.find(function (e) { return new Date(e.end + 'T23:59:59') >= today; });
    bar.textContent = '';
    if (!next) { bar.innerHTML = '&nbsp;'; return; }
    bar.append('Next performance · ' + next.date + ' · ' + next.title + ' · ');
    var link = document.createElement('a');
    if (next.tickets) {
      link.href = next.tickets;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = 'Tickets';
    } else {
      link.href = '/calendar.html';
      link.textContent = 'Details';
    }
    bar.append(link);
  })();
</script>
<header class="site-header">
  <div class="brand">
    <a href="/"><img src="/images/jonah-signature.png" width="732" height="432" alt="Jonah Kim"></a>
    <span class="tagline">Official site of cellist Jonah Kim</span>
  </div>
  <SocialIcons />
</header>
<nav class="site-nav">
  <ul>
    {nav.map((item) => (
      <li><a href={item.href} class={item.key === active ? 'active' : undefined}>{item.label}</a></li>
    ))}
  </ul>
</nav>

<main>
<slot />
</main>

<footer class="site-footer">
  <SocialIcons />
  <p>&copy; {new Date().getFullYear()} Jonah Kim. All rights reserved.</p>
</footer>
<slot name="end" />
</body>
</html>
